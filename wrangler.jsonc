// Cloudflare Workers Builds runs `npm run build`, then publishes dist/ as static files.
// "name" must match the Worker's name in the Cloudflare dashboard (team-sheeeep).
{
  "name": "team-sheeeep",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // Branches other than main are built with `wrangler preview`, which needs this block (it can stay empty).
  "previews": {}
}
